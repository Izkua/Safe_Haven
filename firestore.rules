rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      // Hackathon-simple: any signed-in user can read profiles (needed to show group members).
      // TODO [SYNC]: tighten to "shares a group with me" if time allows.
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      // resource == null lets a client read a group doc that no longer exists (gets "not found"
      // instead of permission-denied, which was breaking stale saved groups).
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      // Joining by invite code: allow a query on inviteCode, and an update that only adds yourself.
      allow list: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds;

      // Announcements: only members read or post; you can only post as yourself; no deletes.
      // The only edit is adding yourself to ackedBy ("seen"), and nobody can create one pre-acked.
      match /announcements/{aid} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 140
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.sentAt is number
          && !('ackedBy' in request.resource.data);
        allow update: if signedIn() && isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackedBy'])
          && request.resource.data.ackedBy.toSet() == resource.data.get('ackedBy', []).toSet().union([request.auth.uid].toSet());
      }
    }
  }
}
