rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      // Hackathon-simple: any signed-in user can read profiles (needed to show group members).
      // TODO [SYNC]: tighten to "shares a group with me" if time allows.
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberIds;
      // Joining by invite code: allow a query on inviteCode, and an update that only adds yourself.
      allow list: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds;
    }
  }
}
