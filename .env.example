# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these blank to run in DEMO MODE (mock group around UW, no backend needed).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Tile provider that permits offline caching (MapTiler / Stadia free tier). {z}/{x}/{y} are filled in.
EXPO_PUBLIC_TILE_URL_TEMPLATE=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
